 "ITEM_SUPERIOR": {
  "$re": "^(.*) высокого качества$",
  "$flags": ""
 },
 "ITEM_EXCEPTIONAL": {
  "$re": "^Образцовое (.*)$",
  "$flags": ""
 },
 "MAP_BLIGHTED": {
  "$re": "^Заражённая (.*)$",
  "$flags": ""
 },
 "MAP_BLIGHT_RAVAGED": {
  "$re": "^Разорённая Скверной (.*)$",
  "$flags": ""
 },
 "ITEM_SYNTHESISED": {
  "$re": "^Синтезированное (.*)$",
  "$flags": ""
 },
 "FLASK_CHARGES": {
  "$re": "^Содержит зарядов: \\d+$",
  "$flags": ""
 },
 "METAMORPH_BRAIN": {
  "$re": "^.* Brain$",
  "$flags": ""
 },
 "METAMORPH_EYE": {
  "$re": "^.* Eye$",
  "$flags": ""
 },
 "METAMORPH_LUNG": {
  "$re": "^.* Lung$",
  "$flags": ""
 },
 "METAMORPH_HEART": {
  "$re": "^.* Heart$",
  "$flags": ""
 },
 "METAMORPH_LIVER": {
  "$re": "^.* Liver$",
  "$flags": ""
 },
 "QUALITY_ANOMALOUS": {
  "$re": "^Аномальный: (.*)$",
  "$flags": ""
 },
 "QUALITY_DIVERGENT": {
  "$re": "^Искривлённый: (.*)$",
  "$flags": ""
 },
 "QUALITY_PHANTASMAL": {
  "$re": "^Фантомный: (.*)$",
  "$flags": ""
 },
 "MODIFIER_LINE": {
  "$re": "^(?<type>[^\"]+)(?:\\s+\"(?<name>[^\"]*)\")?(?:\\s*\\(Уровень: (?<tier>\\d+)\\))?(?:\\s*\\(Ранг: (?<rank>\\d+)\\))?$",
  "$flags": ""
 },
 "MODIFIER_INCREASED": {
  "$re": "^(.*)% увеличение$",
  "$flags": ""
 },
 "EATER_IMPLICIT": {
  "$re": "^Собственное свойство Пожирателя миров \\((?<rank>.+)\\)$",
  "$flags": ""
 },
 "EXARCH_IMPLICIT": {
  "$re": "^Собственное свойство Пламенного экзарха \\((?<rank>.+)\\)$",
  "$flags": ""
 },
 "CHAT_SYSTEM": {
  "$re": "^: (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_TRADE": {
  "$re": "^\\$(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_GLOBAL": {
  "$re": "^#(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_PARTY": {
  "$re": "^%(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_GUILD": {
  "$re": "^&(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_WHISPER_TO": {
  "$re": "^@Кому (?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_WHISPER_FROM": {
  "$re": "^@От кого (?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_WEBTRADE_GEM": {
  "$re": "^level (?<gem_lvl>\\d+) (?<gem_qual>\\d+)% (?<gem_name>.+)$",
  "$flags": ""
 },
 "LOG_LEVEL_UP": {
  "$re": "^(?<char_name>.*) \\((?<char_class>.*)\\) достигает (?<level>\\d+) уровня$",
  "$flags": ""
 },
 "LOG_ZONE_GEN": {
  "$re": "^Generating level (?<area_level>\\d+) area \"(?<zone>.*)\" with seed (?<seed>\\d+)$",
  "$flags": ""
 },
 "REQUIRES_LINE": {
  "$re": "^Требуется: \\s*(?:Уровень[^\\d,]*(?<level>\\d+))?\\D*(?:(?<str>\\d+)[^\\d,]*(Сила|Сила))?\\D*(?:(?<dex>\\d+)[^\\d,]*(Ловкость|Ловк))?\\D*(?:(?<int>\\d+)[^\\d,]*(Интеллект|Инт))?$",
  "$flags": ""
 },
 "UNIDENTIFIED": {
  "$re": "^Неопознано(?:\\s*\\(Ранг\\s*(?<tier>\\d+)\\))?$",
  "$flags": ""
 }
}
