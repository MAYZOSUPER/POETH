 "ITEM_SUPERIOR": {
  "$re": "^Superior (.*)$",
  "$flags": ""
 },
 "ITEM_EXCEPTIONAL": {
  "$re": "^Exceptional (.*)$",
  "$flags": ""
 },
 "MAP_BLIGHTED": {
  "$re": "^Blighted (.*)$",
  "$flags": ""
 },
 "MAP_BLIGHT_RAVAGED": {
  "$re": "^Blight-ravaged (.*)$",
  "$flags": ""
 },
 "ITEM_SYNTHESISED": {
  "$re": "^Synthesised (.*)$",
  "$flags": ""
 },
 "FLASK_CHARGES": {
  "$re": "^Currently has \\d+ Charges$",
  "$flags": ""
 },
 "METAMORPH_BRAIN": {
  "$re": "^.* Brain$",
  "$flags": ""
 },
 "METAMORPH_EYE": {
  "$re": "^.* Eye$",
  "$flags": ""
 },
 "METAMORPH_LUNG": {
  "$re": "^.* Lung$",
  "$flags": ""
 },
 "METAMORPH_HEART": {
  "$re": "^.* Heart$",
  "$flags": ""
 },
 "METAMORPH_LIVER": {
  "$re": "^.* Liver$",
  "$flags": ""
 },
 "QUALITY_ANOMALOUS": {
  "$re": "^Anomalous (.*)$",
  "$flags": ""
 },
 "QUALITY_DIVERGENT": {
  "$re": "^Divergent (.*)$",
  "$flags": ""
 },
 "QUALITY_PHANTASMAL": {
  "$re": "^Phantasmal (.*)$",
  "$flags": ""
 },
 "MODIFIER_LINE": {
  "$re": "^(?<type>[^\"]+)(?:\\s+\"(?<name>[^\"]*)\")?(?:\\s*\\(Tier: (?<tier>\\d+)\\))?(?:\\s*\\(Rank: (?<rank>\\d+)\\))?$",
  "$flags": ""
 },
 "MODIFIER_INCREASED": {
  "$re": "^(.*)% Increased$",
  "$flags": ""
 },
 "EATER_IMPLICIT": {
  "$re": "^Eater of Worlds Implicit Modifier \\((?<rank>.+)\\)$",
  "$flags": ""
 },
 "EXARCH_IMPLICIT": {
  "$re": "^Searing Exarch Implicit Modifier \\((?<rank>.+)\\)$",
  "$flags": ""
 },
 "CHAT_SYSTEM": {
  "$re": "^: (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_TRADE": {
  "$re": "^\\$(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_GLOBAL": {
  "$re": "^#(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_PARTY": {
  "$re": "^%(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_GUILD": {
  "$re": "^&(?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_WHISPER_TO": {
  "$re": "^@To (?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_WHISPER_FROM": {
  "$re": "^@From (?:<(?<guild_tag>.+?)> )?(?<char_name>.+?): (?<body>.+)$",
  "$flags": ""
 },
 "CHAT_WEBTRADE_GEM": {
  "$re": "^level (?<gem_lvl>\\d+) (?<gem_qual>\\d+)% (?<gem_name>.+)$",
  "$flags": ""
 },
 "LOG_LEVEL_UP": {
  "$re": "^(?<char_name>.*) \\((?<char_class>.*)\\) is now level (?<level>\\d+)$",
  "$flags": ""
 },
 "LOG_ZONE_GEN": {
  "$re": "^Generating level (?<area_level>\\d+) area \"(?<zone>.*)\" with seed (?<seed>\\d+)$",
  "$flags": ""
 },
 "REQUIRES_LINE": {
  "$re": "^Requires: \\s*(?:Level[^\\d,]*(?<level>\\d+))?\\D*(?:(?<str>\\d+)[^\\d,]*(Strength|Str))?\\D*(?:(?<dex>\\d+)[^\\d,]*(Dexterity|Dex))?\\D*(?:(?<int>\\d+)[^\\d,]*(Intelligence|Int))?$",
  "$flags": ""
 },
 "UNIDENTIFIED": {
  "$re": "^Unidentified(?:\\s*\\(Tier\\s*(?<tier>\\d+)\\))?$",
  "$flags": ""
 }
}
