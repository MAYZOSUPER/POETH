{
  "name": "poeth",
  "productName": "POETH",
  "version": "0.1.0",
  "description": "POE Trade Helper — оверлей-помощник по трейду для Path of Exile 1/2 (прайс-чек, live search, regex, сделки) + трекер кампании PoE2",
  "author": "POETH contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:trade": "node scripts/test-trade.mjs",
    "build:data": "node tools/dataset-build/build.mjs",
    "build:tray-icon": "node tools/make-tray-icon.mjs",
    "validate:data": "node scripts/validate-dataset.mjs",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-overlay-window": "4.1.0",
    "uiohook-napi": "1.5.5",
    "ws": "^8.22.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.10.6",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
